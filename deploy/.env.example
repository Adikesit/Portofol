# Copy file ini jadi ".env" di folder yang sama (di tiap VM), lalu isi
# sesuai VM ini. JANGAN commit file .env ke git (sudah ada di .gitignore).

# Ganti "namadockerhub" sama username Docker Hub kamu.
IMAGE=namadockerhub/portofol:latest

CONTAINER_NAME=portofol

# Port yang didengar VM ke luar (ini yang wajib 8080, dipakai health probe
# & load balancing rule Azure — JANGAN diubah).
HOST_PORT=8080

# Port yang didengar nginx DI DALAM container. Defaultnya nginx:alpine
# listen di 80, jadi biarin 80 (lihat catatan di Dockerfile).
CONTAINER_PORT=80
